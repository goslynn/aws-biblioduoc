# Material de origen: la guia del profesor y los ZIP de la entrega anterior.
# Se mantiene fuera de git (regla que ya existia en el commit inicial): son
# archivos pesados y de terceros. El plan de trabajo se referencia desde el
# README pero vive solo en local.
.context/

# ---- Backend (Maven) ----
back/target/
back/.mvn/wrapper/maven-wrapper.jar

# ---- Frontend (Angular) ----
front/node_modules/
front/.angular/
front/dist/

# Configuracion del frontend GENERADA por aws/pipeline/publish-web.sh a partir
# de los Outputs de CloudFormation. No se versiona: cambia con cada cuenta AWS.
front/src/app/aws-config.ts

# Ruta de la vista de diagnostico, GENERADA por el mismo script segun la
# variable de entorno DEBUG. Es lo que decide si esa pantalla -- que ensena el
# access token en claro -- llega o no al sitio publicado. Plantillas:
# diagnostico/rutas.example.ts (apagada) y rutas.example-debug.ts (encendida).
front/src/app/diagnostico/rutas.ts

# ---- Bruno ----
# Los entornos los genera aws/pipeline/bruno-env.sh y LLEVAN TOKENS REALES.
bruno/environments/aws*.yml
bruno/.env

# ---- Local / temporal ----
aws/.local/
# Variables de los scripts (SMTP_PASSWORD incluida). Plantilla: aws/.env.example
aws/.env
*.log
.DS_Store
