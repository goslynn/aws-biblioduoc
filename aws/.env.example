# ==============================================================================
#  aws/.env.example   --   Plantilla de aws/.env
# ==============================================================================
#
#  cp aws/.env.example aws/.env   y rellena. aws/.env esta en .gitignore:
#  lleva la contrasena del correo y NO se versiona.
#
#  Lo leen todos los scripts de aws/ (via _comun.sh). Formato VARIABLE=valor,
#  una por linea; las comillas son opcionales. Lo que se pase en la terminal
#  gana sobre este archivo.
#
#  Las SMTP_* solo hacen falta la PRIMERA vez que se crea el backend: despues
#  quedan en Secrets Manager / SSM y CloudFormation las conserva. Si las dejas
#  aqui, cada build-backend.sh las vuelve a enviar (mismo valor, sin efecto).
# ==============================================================================

# ---- Proveedor de correo (Gmail con contrasena de aplicacion) ----
# La contrasena de aplicacion se crea en myaccount.google.com/apppasswords
# (exige verificacion en dos pasos). 16 letras, sin espacios.
SMTP_HOST=smtp.gmail.com
SMTP_USER=tucuenta@gmail.com
SMTP_PASSWORD=
SMTP_FROM=tucuenta@gmail.com

# ---- Usuarios de demostracion (opcional) ----
# El alumno recibe los avisos en este correo: ponle uno real si quieres verlos.
# DEMO_USER=alumno@duoc.cl
# DEMO_EMPLOYEE=empleado@duoc.cl
