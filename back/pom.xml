<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>cl.duoc</groupId>
  <artifactId>biblioteca-backend</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>biblioteca-backend</name>
  <description>API interna de la Biblioteca Duoc: catalogo de libros y solicitudes de prestamo</description>

  <properties>
    <!-- 21 para que coincida con la imagen amazoncorretto:21 de la EC2 (aws/backend.yaml). -->
    <java.version>21</java.version>
    <aws-sdk.version>2.57.5</aws-sdk.version>
    <greenmail.version>2.1.15</greenmail.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Versiones alineadas de todos los clientes del AWS SDK v2. -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws-sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Spring MVC + Tomcat embebido. En Spring Boot 4 el starter se llama
         "webmvc"; en Boot 3 era "web". El NLB de aws/backend.yaml le reenvia
         el trafico de API Gateway al puerto 8080. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!-- Bean Validation (@Valid, @NotBlank, @Min...). Es lo que convierte una
         solicitud mal formada en un 400 con detalle, en vez de un 500. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- SEGUNDA VALIDACION DEL JWT (Defense in Depth).
         API Gateway ya valida el token antes de reenviar la peticion. Estas dos
         dependencias hacen que Spring lo vuelva a validar por su cuenta, de
         modo que una llamada que llegue a la EC2 por otro camino (la VPN, por
         ejemplo) tambien sea rechazada. Ver config/SecurityConfig. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!-- PERSISTENCIA. JDBC a secas (JdbcClient), no JPA: Hibernate anade
         segundos al arranque y aqui no aporta nada, porque
         el modelo ya son records inmutables y las consultas caben en SQL. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Flyway crea el esquema, el rol de la aplicacion y SIEMBRA el catalogo
         (src/main/resources/db/migration). Corre dentro de la propia aplicacion al
         arrancar: la base es privada y no hay otra maquina en su red. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- MENSAJERIA. Cliente AMQP de RabbitMQ (RabbitTemplate, @RabbitListener).
         El broker corre en la misma EC2 que la aplicacion. Ver avisos/. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>

    <!-- Envio de correo por SMTP (JavaMailSender). El proveedor se elige al
         desplegar: host, puerto, usuario y contrasena llegan por variables. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <!-- Para leer el email VERIFICADO de un usuario desde Cognito al activar
         los avisos. El correo nunca lo escribe el usuario. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>cognitoidentityprovider</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Los tests corren contra un Postgres REAL en Docker, con las mismas
         migraciones que en AWS. Necesita Docker para "mvnw package". -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Un RabbitMQ real en Docker, igual que el Postgres. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Servidor SMTP en memoria: recibe los correos de los tests. -->
    <dependency>
      <groupId>com.icegreen</groupId>
      <artifactId>greenmail</artifactId>
      <version>${greenmail.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Genera el "fat jar" ejecutable: el MISMO artefacto que corre con
           "java -jar" en cualquier maquina y dentro del contenedor de la EC2. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
